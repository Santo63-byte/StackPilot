{
    "app_info": {
        "app_name": "StackPilot",
        "version": "0.0.1",
        "port": 8017
    },
    "app_settings": {
        "refresh_interval": 30,
        "enable_notifications": true,
        "error_reporting": true,
        "storage": "D_Drive_Temp",
        "terminal": "StackPilot_Terminal",
        "same_window": true,
        "core_addons": {
            "git_integration": {
                "enabled": true
            },
            "console_display": {
                "enabled": true
            },
            "port_killer": {
                "enabled": true
            },
            "path_terminal_opener": {
                "enabled": true
            },
            "multiple_sessions": {
                "enabled": true
            },
            "config_uploader": {
                "enabled": false
            }
        }
    }
}
